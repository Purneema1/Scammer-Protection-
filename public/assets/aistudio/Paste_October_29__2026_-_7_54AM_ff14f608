<script>
function showResult(id, title, reasons, color) {
  const el = document.getElementById(id);
  el.classList.remove("hidden");
  el.style.background = color;
  el.replaceChildren();

  const heading = document.createElement("strong");
  heading.textContent = title;
  el.appendChild(heading);

  const list = document.createElement("ul");
  reasons.forEach(reason => {
    const item = document.createElement("li");
    item.textContent = reason;
    list.appendChild(item);
  });
  el.appendChild(list);

  const note = document.createElement("p");
  note.textContent =
    "Preliminary demo only. This is not a definitive scam verdict.";
  el.appendChild(note);
}

function checkMessage() {
  const text = document.getElementById("msg").value.trim();
  if (!text) {
    alert("Please paste a message first.");
    return;
  }

  const t = text.toLowerCase();
  const signs = [];

  if (/\botp\b|one.time password|verification code|password|pin\b/.test(t))
    signs.push("The message mentions credentials, a PIN, or a verification code.");

  if (/urgent|immediately|within \d+ minutes|act now|last chance|तुरुन्त|अहिले नै|तत्काल/.test(t))
    signs.push("The message uses urgency or pressure.");

  if (/won|winner|prize|lottery|free gift|claim your reward|पुरस्कार|चिठ्ठा/.test(t))
    signs.push("The message mentions a prize or reward.");

  if (/send money|transfer money|pay now|processing fee|payment required|पैसा पठाउ|शुल्क तिर्न/.test(t))
    signs.push("The message asks for payment or a transfer.");

  if (/account suspended|account blocked|will be arrested|legal action|खाता बन्द|कारबाही हुन्छ/.test(t))
    signs.push("The message uses a threat or account-warning tactic.");

  if (signs.length >= 2) {
    showResult("msgResult", "⚠️ High concern: multiple warning signs",
      signs, "#4a252e");
  } else if (signs.length === 1) {
    showResult("msgResult", "⚠️ Caution: a warning sign was found",
      signs, "#493b22");
  } else {
    showResult("msgResult", "No obvious warning signs detected",
      ["This simple checker did not find its listed patterns.",
       "Sophisticated scams may use other wording."], "#1c3d37");
  }
}

function checkLink() {
  const raw = document.getElementById("url").value.trim();
  if (!raw) {
    alert("Please enter a URL first.");
    return;
  }

  let u;
  try {
    u = new URL(raw);
  } catch {
    showResult("urlResult", "⚠️ Invalid URL format",
      ["Check the address for missing or incorrect characters."],
      "#493b22");
    return;
  }

  if (!["http:", "https:"].includes(u.protocol)) {
    showResult("urlResult", "⚠️ Unusual URL scheme",
      ["Only HTTP and HTTPS website addresses are accepted by this demo."],
      "#493b22");
    return;
  }

  const signs = [];
  const host = u.hostname.toLowerCase();

  if (u.username || u.password)
    signs.push("The URL contains user information before the hostname.");

  if (host.startsWith("xn--") || host.includes(".xn--"))
    signs.push("The hostname contains an internationalized domain label; verify it carefully.");

  if (/login|verify|wallet|password|claim-prize|free-gift/.test(
    (host + u.pathname).toLowerCase()))
    signs.push("The URL contains words sometimes used in deceptive links.");

  if (host.split(".").length >= 5)
    signs.push("The hostname has many subdomain levels; verify the real domain.");

  if (u.protocol === "http:")
    signs.push("The URL uses HTTP rather than encrypted HTTPS.");

  if (signs.length) {
    showResult("urlResult", "⚠️ Review this link carefully",
      signs, "#493b22");
  } else {
    showResult("urlResult", "No obvious URL pattern detected",
      ["This demo has not checked a live threat database.",
       "Do not assume the website is safe based on this result."],
      "#1c3d37");
  }
}
</script>
